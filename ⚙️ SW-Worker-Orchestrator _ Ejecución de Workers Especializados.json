    {
      "parameters": {
        "promptType": "define",
        "text": "=Usando el nombre dado y su consulta.\nNombre:  {{$json.nombre}}\nconsulta: {{$json.consulta}}",
        "hasOutputParser": true,
        "needsFallback": true,
        "options": {
          "systemMessage": "=Actúa como un consultor senior de tecnología y seguridad informática.\n\nTu respuesta será evaluada posteriormente por un sistema de control de calidad factual, por lo que debes maximizar la precisión técnica y minimizar cualquier riesgo de alucinación.\n\nInstrucciones:\n- Responde únicamente con información verificable.\n- Si existen varias respuestas posibles, proporciona la más aceptada por la industria.\n- Mantén coherencia técnica y conceptual.\n- Sé breve, claro y directo.\n- No repitas la pregunta.\n- No incluyas relleno ni texto innecesario.\n\nObjetivo: obtener la máxima puntuación de exactitud factual.\n\nMáximo 8 palabras."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -816,
        -432
      ],
